{
  "$id": "content.live.schema.json",
  "title": "content, kind live: a channel a member can watch live in the app; channel_id names the channel entity (docs \u00a72.3)",
  "type": "object",
  "x-playable": [
    "streams"
  ],
  "required": [
    "id",
    "kind",
    "title",
    "channel_id",
    "service",
    "updated_at",
    "window",
    "how",
    "streams",
    "license"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/item_id"
    },
    "ids": {
      "$ref": "common.schema.json#/$defs/ids"
    },
    "channel_id": {
      "$ref": "common.schema.json#/$defs/item_id"
    },
    "updated_at": {
      "$ref": "common.schema.json#/$defs/time"
    },
    "attribution": {
      "$ref": "common.schema.json#/$defs/attribution"
    },
    "kind": {
      "enum": [
        "live"
      ]
    },
    "service": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "access": {
      "enum": [
        "free",
        "subscription",
        "own"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "common.schema.json#/$defs/time"
        },
        "end": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/time"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "how": {
      "enum": [
        "play"
      ]
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "$ref": "common.schema.json#/$defs/region"
      }
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "url",
          "format"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2000
          },
          "format": {
            "enum": [
              "hls",
              "mp4"
            ]
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": [
        "code",
        "name",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "pd",
            "cc0",
            "cc-by",
            "cc-by-sa",
            "subscription",
            "own"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "link": {
          "$ref": "common.schema.json#/$defs/link"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/link"
        },
        "credit": {
          "type": "string",
          "maxLength": 300
        }
      }
    },
    "subcategories": {
      "$ref": "common.schema.json#/$defs/subcategories"
    }
  }
}
